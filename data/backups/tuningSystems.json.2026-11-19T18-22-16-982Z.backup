  {
    "id": "meshshaqa_1899",
    "titleEnglish": "Arabic Octave According to the Modernists",
    "titleArabic": "الديوان العربي عند المحدثين",
    "year": "1899",
    "sourceEnglish": "",
    "sourceArabic": "",
