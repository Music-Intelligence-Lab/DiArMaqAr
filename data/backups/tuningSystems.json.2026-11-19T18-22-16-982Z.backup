            }
          ]
        },
        {
          "id": "hadd",
          "nameEnglish": "ḥadd",
          "nameArabic": "الحاد",
          "openRatio": "256/81",
          "attribution": "secondary",
          "pageReferences": [
            {
              "sourceId": "farmer_1937",
