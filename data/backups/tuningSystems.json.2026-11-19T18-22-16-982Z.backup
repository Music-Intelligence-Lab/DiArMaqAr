  {
    "id": "allami_2025",
    "titleEnglish": "al-Ṣabbāgh with al-Shawwā's 28-Tones",
    "titleArabic": "الصبّاغ الشوا 28 نغمة",
    "year": "2025",
    "sourceEnglish": "Unknown Source",
    "sourceArabic": "مصدر غير معروف",
